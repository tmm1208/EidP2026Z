// options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "EidPy2025",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "shellautocompletion": true,
      "version": "latest"
    },
    // "ghcr.io/jsburckhardt/devcontainer-features/ruff:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "jupyter.jupyterServerType": "local",
        "jupyter.interactiveWindow.textEditor.executeSelection": true,
        "jupyter.enableCellCodeLens": true,
        "jupyter.enableCellCodeActions": true,        
        // https://marketplace.visualstudio.com/items?itemName=vsls-contrib.gitdoc
        "gitdoc.autoPull": "onPush", //"gitdoc.autoPull": "off",
        "gitdoc.commitMessageFormat": "ccc, LLL d, kkkk, h:mm a ZZ",
        "gitdoc.commitValidationLevel": "none",
        "gitdoc.enabled": true,
        "gitdoc.pullOnOpen": true,
        "git.autofetch": true,

        "github.copilot.enable": { "*": false },

      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "kevinrose.vsc-python-indent",
        "aaron-bond.better-comments",
        "tamasfe.even-better-toml",
        // "charliermarsh.ruff",
        "vsls-contrib.gitdoc", // enable gitdoc-settings below if this option is enabled
        "bierner.markdown-mermaid"
      ]
    }
  },
  "postCreateCommand": "uv venv .venv --clear --prompt 'eidPy2025' && uv sync && uv run python -m ipykernel install --user --name .venv --display-name 'Python (.venv)'"
}
